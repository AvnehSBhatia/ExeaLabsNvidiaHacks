# Copy to .env (gitignored) and fill in what you need. Every value is optional: the demo, the sim and the
# tests need none of them. The environment always wins over .env; arrival/config.py lists who reads what.
# Never commit a filled-in copy. Account links: docs/08-access.md.

# Nebius Token Factory: Nemotron planner (sim --planner vlm) and instruction wordings (--instructions nemotron)
TOKEN_FACTORY_API_KEY=
# TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEMOTRON_OMNI_MODEL=
NEMOTRON_ULTRA_MODEL=
NEMOTRON_SUPER_MODEL=
NEMOTRON_LIGHTNING_MODEL=

# Nebius Serverless AI Jobs and Object Storage for arrival fanout --backend nebius (never run against Nebius yet)
# An access token from `nebius iam get-access-token` (valid 12 h) and the project the jobs run in
NEBIUS_IAM_TOKEN=
NEBIUS_PROJECT_ID=
# NEBIUS_API_URL=https://api.nebius.cloud
# The arrival image (repo Dockerfile) in a registry the project can pull from
NEBIUS_JOB_IMAGE=
# NEBIUS_JOB_PLATFORM=cpu-d3
# NEBIUS_JOB_PRESET=4vcpu-16gb
# NEBIUS_JOB_SUBNET_ID=
# A job not finished this long after it was created, or reporting no state this long in a row, is cancelled and
# counts as a failed attempt. The first must exceed the 1 h job timeout the service enforces itself.
# NEBIUS_MAX_JOB_SECONDS=7200
# NEBIUS_MAX_NO_STATE_SECONDS=1800
# MysteryBox secret with payload keys NEBIUS_ACCESS_KEY_ID and NEBIUS_SECRET_ACCESS_KEY, injected into each job
NEBIUS_JOB_S3_SECRET_ID=
# The bucket and an access key pair (`nebius iam v2 access-key create`) for the run's objects
NEBIUS_BUCKET=
NEBIUS_ACCESS_KEY_ID=
NEBIUS_SECRET_ACCESS_KEY=
# NEBIUS_REGION=eu-north1
# NEBIUS_S3_ENDPOINT=https://storage.eu-north1.nebius.cloud

# Tavily: appliance research (research, sim --tavily)
TAVILY_API_KEY=
# TAVILY_BASE_URL=https://api.tavily.com/search

# GR00T policy server for --policy vla, e.g. http://gpu-box:8000
GR00T_POLICY_URL=

# Cosmos endpoint for python -m arrival.render.variation --backend cosmos
COSMOS_URL=

# Hosted limits (arrival/jobs/limits.py; the values below are the defaults). These are read from the process
# environment (docker-compose, export), not from this file.
# ARRIVAL_MAX_UPLOAD_MB=200
# ARRIVAL_MAX_EPISODES=100
# ARRIVAL_MAX_PEOPLE=4
# ARRIVAL_MAX_JOB_SECONDS=1800
# ARRIVAL_MAX_QUEUE=20
# Resident memory cap for one job's process tree, in MB; 0 is off
# ARRIVAL_MAX_JOB_MB=0
# ARRIVAL_JOB_RETRIES=2
# ARRIVAL_JOB_RETRY_BACKOFF=5
# Both web and worker use this deletion window (hours); 0 disables automatic deletion.
# ARRIVAL_RETENTION_HOURS=24

# Set to 0 to ignore .env files entirely (the test suite does this)
# ARRIVAL_DOTENV=1
